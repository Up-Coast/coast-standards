#!/bin/sh
# Coast Standards — the project's commit-msg hook (enforcement task E2.2).
#
# Small on purpose. It holds the commit-message rules a machine can hold:
#   - a subject line that exists and fits in 100 characters
#     (rules/07: a commit message is a sentence a person can read in a log);
#   - session:attribution-trailer (rules/09 "Commit trailers name the model
#     that actually did the work"): a commit made from an agent session
#     (Claude Code sets CLAUDECODE in the shell it runs) must carry a
#     Co-Authored-By trailer naming the SPECIFIC Claude model, e.g.
#       Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
#     and any Claude trailer, from any session, must name a model — a bare
#     "Claude" or "Claude Code" is the mis-attribution the rule forbids.
# It cannot know who typed a human's commit; it refuses only what is
# provably wrong. Refusals print as FAIL lines. GOVERNING file.
set -u
export PYTHONDONTWRITEBYTECODE=1   # the config reader leaves no __pycache__ in the project
file=$1
# The layout (the state dir's name is the one the hook carries; the rest is the table adopt.py rendered).
state=${COAST_STATE_DIR:-.coast}
if [ ! -f "$state/layout.sh" ]; then
  echo "FAIL commit-msg $state/layout.sh:0:missing: the layout file is not written — run enforcement/adopt.py from the standards repo" >&2
  exit 1
fi
. "./$state/layout.sh"
# The config's switches (seats, linters, session hooks off), read fresh from config.json each run.
if [ -f "$layout_checks_dir/config.py" ]; then
  switches=$(python3 "$layout_checks_dir/config.py" --sh) || { echo "FAIL commit-msg $state/config.json:0:config: the config refuses to load — see the line above" >&2; exit 1; }
  eval "$switches"
fi
if [ ! -f "$file" ]; then
  echo "FAIL commit-msg $file:0:missing: no commit message file was given" >&2
  exit 1
fi

# The message without git's comment lines. A comment is `#` alone or `#` followed by
# a space or a tab (git's own template lines look like that); `#123 fix the crash`
# is a subject naming an issue, not a comment, and is kept.
message() { grep -v -E '^#([[:space:]]|$)' "$file"; }

# The subject: the first non-blank line that is not a comment.
subject=$(message | grep -m1 -v '^[[:space:]]*$' || true)
if [ -z "$subject" ]; then
  echo "FAIL commit-msg $file:1:empty-subject: the commit message has no subject line — say what changed and why, in plain words" >&2
  exit 1
fi

# The messages git writes itself: `git merge` ("Merge branch 'x'", "Merge remote-tracking
# branch 'origin/x' into y", "Merge pull request #1 from a/b", "Merge tag 'v1'") and
# `git revert` ("Revert \"…\"" over "This reverts commit <sha>."). Their words are git's,
# not the committer's, so the length and attribution rules do not apply to them.
gits_own=0
case "$subject" in
  "Merge branch "*|"Merge remote-tracking branch "*|"Merge tag "*|"Merge commit "*|"Merge pull request "*|"Merge branches "*)
    gits_own=1 ;;
  "Revert \""*"\"")
    message | grep -q -E '^This reverts commit [0-9a-f]{7,40}\.' && gits_own=1 ;;
esac
if [ "$gits_own" = 1 ]; then
  printf 'gate: commit-msg — a message git wrote itself; its words are not held to the rules\n'
fi

length=$(printf '%s' "$subject" | python3 -c 'import sys; print(len(sys.stdin.buffer.read().decode("utf-8", "replace")))')
if [ "$gits_own" = 0 ] && [ "$length" -gt 100 ]; then
  echo "FAIL commit-msg $file:1:subject-length: the subject line is $length characters; keep it to 100 and put the rest in the body" >&2
  exit 1
fi

# session:attribution-trailer — the model that did the work is named. A project whose config
# switches the hook off (session_hooks.off, rendered into layout.sh) says so and skips it.
attribution=on
case " ${config_session_hooks_off:-} " in
  *" attribution-trailer "*) printf 'gate: attribution-trailer OFF (config)\n'; attribution=off ;;
esac
model_trailer='^Co-Authored-By: Claude [A-Z][A-Za-z]+ [0-9][0-9.]* <[^>]+>[[:space:]]*$'
if [ "$attribution" = off ]; then
  :
elif message | grep -q -i '^Co-Authored-By:[[:space:]]*Claude'; then
  if ! message | grep -E -q "$model_trailer"; then
    echo "FAIL commit-msg $file:0:attribution-trailer: a Claude trailer must name the model that did the work, like 'Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>' — 'Claude' or 'Claude Code' alone mis-attributes the commit" >&2
    exit 1
  fi
elif [ -n "${CLAUDECODE:-}" ] && [ "$gits_own" = 0 ]; then
  echo "FAIL commit-msg $file:0:attribution-trailer: this commit comes from an agent session but names no model — end the message with 'Co-Authored-By: Claude <model> <version> <noreply@anthropic.com>' (rules/09)" >&2
  exit 1
fi
# A project that had its own hooks keeps them: ours ran, now its own does.
if [ -f "$state/previous-hooks-path" ]; then
  previous=$(tr -d '[:space:]' < "$state/previous-hooks-path")
  if [ -n "$previous" ] && [ -f "$previous/commit-msg" ]; then
    printf 'gate: %s/commit-msg (this project had it before it adopted)\n' "$previous"
    if [ -x "$previous/commit-msg" ]; then
      "$previous/commit-msg" "$file" || exit 1
    else
      sh "$previous/commit-msg" "$file" || exit 1
    fi
  fi
fi

exit 0
