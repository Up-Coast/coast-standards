#!/bin/sh
# Up Coast standards — the project's pre-commit hook (enforcement task E2.2).
#
# Seconds, not minutes: the rules scanner on the STAGED diff and the
# doc-comment check on the staged product files. The full battery runs at
# push (.githooks/pre-push). Both refuse in the checks' own FAIL lines, so a
# human and an agent meet the same wall (enforcement/README.md §4.4).
#
# Installed by enforcement/adopt.py, which also sets
#   git config core.hooksPath .githooks
# The platform is one word in .coast/platform (or COAST_PLATFORM); the
# checks live under Scripts/checks/ (COAST_CHECKS_DIR overrides, for tests).
# GOVERNING: agents never edit the files that define their own checks.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
# git exports GIT_DIR and friends to a hook run from a linked worktree or a
# subdirectory; left in the environment they redirect every git command a
# check runs. The battery always runs with a clean git environment.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_PREFIX
export PYTHONDONTWRITEBYTECODE=1   # the checks leave no __pycache__ in the project

checks=${COAST_CHECKS_DIR:-Scripts/checks}
platform=${COAST_PLATFORM:-}
if [ -z "$platform" ] && [ -f .coast/platform ]; then
  platform=$(tr -d '[:space:]' < .coast/platform)
fi
if [ -z "$platform" ]; then
  echo "FAIL pre-commit .coast/platform:0:platform: no platform named — write one word (ios, macos, android, react-native, web, python) to .coast/platform, or run adopt.py" >&2
  exit 1
fi
if [ ! -f "$checks/check_rules.py" ]; then
  echo "FAIL pre-commit $checks/check_rules.py:0:missing: the rules scanner is not installed — run enforcement/adopt.py from the standards repo" >&2
  exit 1
fi

run() {
  name=$1; shift
  printf 'gate: %s\n' "$name"
  if ! "$@"; then
    printf 'gate: %s failed — the commit was refused. Fix what it printed, then commit again.\n' "$name" >&2
    exit 1
  fi
}

run "rules-scan (staged)" python3 "$checks/check_rules.py" --staged --platform "$platform"

# The doc-comment check on the staged product files (the platform's source
# extensions, from paths.json). Ships with E1.5; until the script is present
# the seat says so out loud instead of pretending.
if [ -f "$checks/check_doc_comments.py" ]; then
  staged=$(git diff --cached --name-only --diff-filter=ACMR | python3 -c '
import json, os, sys
checks = sys.argv[1]; platform = sys.argv[2]
table = json.load(open(os.path.join(checks, "paths.json")))["platforms"].get(platform, {})
exts = tuple(table.get("extensions", []))
for line in sys.stdin.read().splitlines():
    if line.endswith(exts) and os.path.isfile(line):
        print(line)
' "$checks" "$platform")
  if [ -n "$staged" ]; then
    # shellcheck disable=SC2086
    run "doc-comments (staged)" python3 "$checks/check_doc_comments.py" --files $staged
  else
    printf 'gate: doc-comments (staged) — no product files staged\n'
  fi
else
  printf 'gate: doc-comments — not installed yet (check_doc_comments.py ships with E1.5); this seat is not held\n'
fi

printf 'gate: every pre-commit check green\n'
