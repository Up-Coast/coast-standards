{
  "_comment": "Per-platform signature tables the scanner (check_rules.py) runs and verify_rules.py resolves rule tags against. Fields: id (stable; approved deviations and exceptions cite it), rule (the rule id it holds), group (optional: several signatures held by one rule tag, e.g. native-pattern), severity block|ratchet|advisory, scope added|tree, applies_to / excludes (path classes from paths.json; '*' = every class), files (optional glob list; default = the platform's extensions), pattern (regex over a line, and over the file's added lines joined without whitespace), paired (optional second regex that must also match), words (the failure's plain words). kind 'builtin' names a check implemented in code rather than a regex.",
  "platforms": {
    "ios": {
      "signatures": [
        {
          "id": "appkit-reach-through",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "\\b(NSWindow|NSApplication|NSApp)\\b",
          "words": "raw NSWindow/NSApplication reach-through from SwiftUI — window behavior belongs to SwiftUI's scene and window APIs"
        },
        {
          "id": "representable-window-reach",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "\\bNSViewRepresentable\\b",
          "words": "an NSViewRepresentable touching .window — a bridge view reaching into the hosting window's chrome",
          "paired": "\\.window\\b"
        },
        {
          "id": "window-chrome-override",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "\\b(standardWindowButton|styleMask|makeKeyAndOrderFront|titlebarAppearsTransparent)\\b",
          "words": "window-chrome override (standardWindowButton/styleMask/makeKeyAndOrderFront/titlebarAppearsTransparent) — replaces the platform's window controls"
        },
        {
          "id": "hidden-window-toolbar",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "\\.toolbar\\(\\s*\\.hidden\\s*,\\s*for:\\s*\\.windowToolbar\\s*\\)",
          "words": "hiding the window toolbar (.toolbar(.hidden, for: .windowToolbar)) — removes the native title bar and traffic lights"
        },
        {
          "id": "hand-rolled-router",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "\\benum\\s+\\w*Route\\w*\\b",
          "words": "a hand-rolled Route enum in place of NavigationStack — navigation belongs to the platform's navigation container"
        },
        {
          "id": "scrim-modal",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "Color\\.black\\.opacity\\(",
          "words": "a full-screen scrim/dimming overlay used as a modal — modals belong to .sheet/.popover/.alert"
        },
        {
          "id": "nsevent-key-monitor",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "NSEvent\\s*\\.\\s*add(Local|Global)MonitorForEvents",
          "words": "an NSEvent key monitor — key handling belongs to the platform's focus and command system"
        },
        {
          "id": "focus-key-override",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "(@FocusState\\b|\\.focused\\()",
          "words": "focus APIs used to override key handling — the platform's command/shortcut system owns keys",
          "paired": "(\\.onKeyPress\\(|keyDown|NSEvent)"
        },
        {
          "id": "custom-title-bar",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "\\.windowStyle\\(\\s*\\.hiddenTitleBar\\s*\\)|\\b(struct|class)\\s+\\w*(TitleBar|HeaderBar)\\w*\\b",
          "words": "a custom header/title bar in a hidden-title-bar window — the window's native title bar and toolbar own the header; if the platform provides the feature, use the feature"
        },
        {
          "id": "custom-tab-bar",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "\\b(struct|class)\\s+\\w*TabBar\\w*\\b",
          "words": "a hand-built tab bar — tab navigation belongs to TabView, even when every piece of the substitute is a native control"
        },
        {
          "id": "hand-rolled-search-field",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "\\bmagnifyingglass\\b",
          "words": "a hand-rolled search field (a TextField dressed with the search icon) — search belongs to .searchable",
          "paired": "TextField\\("
        },
        {
          "id": "custom-sidebar",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "\\.listStyle\\(\\s*\\.sidebar\\s*\\)|SidebarListStyle\\(",
          "words": "a hand-styled sidebar list — sidebars belong to NavigationSplitView, which provides the sidebar column and its styling itself"
        },
        {
          "id": "hand-drawn-progress",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "\\b(struct|class)\\s+\\w*(ProgressBar|Spinner|LoadingIndicator|ActivityIndicator)\\w*\\b",
          "words": "a hand-drawn progress indicator — progress belongs to ProgressView"
        },
        {
          "id": "custom-picker-control",
          "rule": "A-7",
          "group": "native-pattern",
          "severity": "block",
          "scope": "added",
          "applies_to": [
            "*"
          ],
          "excludes": [
            "tests"
          ],
          "files": [
            "**/*.swift"
          ],
          "pattern": "\\b(struct|class)\\s+Custom\\w*(Picker|Slider|Stepper|Toggle)\\w*\\b",
          "words": "a custom-built control where the platform provides one (Picker/Slider/Stepper/Toggle) — use the native control"
        },
        {
          "id": "import-matrix",
          "rule": "A-2",
          "kind": "builtin",
          "severity": "block",
          "scope": "tree",
          "words": "module layering: feature modules never import each other, only the app target imports Data, Domain imports nothing app-side"
        }
      ]
    },
